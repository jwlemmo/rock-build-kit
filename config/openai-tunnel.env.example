# Save as local/openai-dev.env or local/openai-prod.env, never in Git.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace
CONTROL_PLANE_API_KEY=replace-locally-with-runtime-key
# Optional if this key belongs to multiple organizations:
# CONTROL_PLANE_ORGANIZATION_ID=org_replace
# Absolute path, useful for background services:
# TUNNEL_CLIENT_BIN=/absolute/path/to/tunnel-client
# macOS alternative to literal key; use your own Keychain service:
# CONTROL_PLANE_KEYCHAIN_SERVICE=your-service-name
