# Local dotenv data only. Enter secrets in an editor, never chat or command arguments.
ROCK_API_URL=https://rock-dev.example.org/api
ROCK_API_KEY=replace-locally
ROCK_OPERATOR_EMAIL=operator@example.org
ROCK_OPERATOR_NAME=Your Name
# Optional headless browser impersonation; discover your real Person ID.
# ROCK_UI_PERSON_ID=
# Optional dev change-bundle gate:
# ROCK_DEV_HOST=rock-dev.your-church.example
# ROCK_REQUIRE_CHANGE_BUNDLE=1
# ROCK_CHANGELOG_DIR=/absolute/path/to/rock-changelog
